        <!-- THEME TOGGLES ===================================================================-->
            
            <!-- lottie UI animations -->
            <lottieUI>true</lottieUI>

            <!-- lottie UI STAIC replacement -->
            <imageUI>false</imageUI>

            <!-- Game list lightbox & frames -->
            <glistframe>true</glistframe>

            <!-- noise lottie -->
            <noise>false</noise>

            <!-- Alpha logo Visible-->
            <alphaTit>true</alphaTit>

            <!-- Noise video -->
            <glistNoise>true</glistNoise>
            <sysNoise>true</sysNoise>
