<theme>
    <view name="gamelist">
        <carousel name="main">
            <systemNameSuffix>false</systemNameSuffix>
        </carousel>
        <image name="syslogo">
            <pos>0.05 .12</pos>
            <path>./../assets/default-media/logos/${system.theme}.svg</path>
            <maxSize>.2 .07</maxSize>
            <zIndex>5</zIndex>
            <color>${sysLogoAltColor}</color>
        </image> 
         <text name="collectionName">
            <size>.6 .02</size>
            <pos>0.26 .145</pos>
            <horizontalAlignment>left</horizontalAlignment>
            <letterCase>uppercase</letterCase>
            <fontSize>0.065</fontSize>
            <fontPath>./.${carouselFont}</fontPath>
            <metadata>systemName</metadata>
            <defaultValue>:space:</defaultValue> 
            <color>${gmenu}</color>
            <lineSpacing>1.5</lineSpacing>
            <zIndex>65</zIndex>
        </text>
        <text name="gameSystemTxt">
            <size>.2 .024</size>
            <pos>0.05 0.465</pos>
            <horizontalAlignment>left</horizontalAlignment>
            <letterCase>uppercase</letterCase>
            <fontSize>0.06</fontSize>
            <fontPath>${cCollectionSys}</fontPath>
            <defaultValue>Collection</defaultValue> 
            <metadata>sourceSystemName</metadata>
            <defaultValue>Collection</defaultValue> 
            <color>${cCollectionColor}</color>
            <lineSpacing>1.5</lineSpacing>
            <zIndex>65</zIndex>
        </text>
        


        <rating name="gamerating">
            <visible>false</visible>
        </rating>

    </view>
