<theme>
    <view name="gamelist">
         <carousel name="games">
                <origin>.5 0</origin>
                <pos>.5 .3</pos>	
                <size>1.07 1</size>
                <fontSize>.036</fontSize>
                <itemSize>.2 .3</itemSize> 
                <fontPath>${carouselFont}</fontPath>
                <letterCase>${carouselLC}</letterCase>
                <imageType>physicalmedia, cover</imageType>
                <maxItemCount>5</maxItemCount>
                <selectedItemMargins>.08 .08</selectedItemMargins>
                <selectedItemOffset>0 -.06</selectedItemOffset>
                <itemScale>1.85</itemScale>
                <lineSpacing>.9</lineSpacing>
                <defaultImage>./assets/default-media/physical-media/${system.theme}.webp</defaultImage>
                <defaultFolderImage>./assets/default-media/physical-media/folder.png</defaultFolderImage>
                <unfocusedItemOpacity>0.5</unfocusedItemOpacity>
                <color>${carItemColor}00</color>
                <fastScrolling>true</fastScrolling>
                <textColor>${carItemColor}</textColor>
                <textSelectedColor>${carouselAltColor}</textSelectedColor>
                <zIndex>5</zIndex>
        </carousel>
        <text name="game-title">
            <pos>.5 .29</pos>
            <origin>.5 0</origin>
            <size>.8 .07</size>
            <fontPath>${carouselFont}</fontPath>
            <letterCase>${carouselLC}</letterCase>
            <defaultValue>unknown...</defaultValue>
            <fontSize>.1</fontSize>
            <metadata>name</metadata>
            <horizontalAlignment>center</horizontalAlignment>
            <color>${carouselAltColor}</color>
            <letterCase>capitalize</letterCase>
            <zIndex>5</zIndex>
        </text>
        <text name="playtimeLBL">    
                <pos>.625 .53</pos>
                <size>.15 .018</size>
                <horizontalAlignment>left</horizontalAlignment>
                <fontPath>${playtimeFont}</fontPath>
                <fontSize>.022</fontSize>
                <text>Time Invested:</text>
                <defaultValue>Never Played</defaultValue>
                <color>${carouselAltColor}</color>
                <lineSpacing>1</lineSpacing>
                <zIndex>10</zIndex>
        </text> 
        <text name="playtime">    
                <pos>.71 .53</pos>
                <size>.15 .018</size>
                <horizontalAlignment>left</horizontalAlignment>
                <fontPath>${playtimeFont}</fontPath>
                <fontSize>.022</fontSize>
                <metadata>playtime</metadata>
                <defaultValue>Never Played</defaultValue>
                <color>${playtimeColor}</color>
                <lineSpacing>1</lineSpacing>
                <zIndex>10</zIndex>
        </text>
        <rating name="gamerating">
