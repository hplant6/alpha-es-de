        <text name="playtimeLBL">    
                <pos>.57 .965</pos>
                <size>.15 .018</size>
                <horizontalAlignment>left</horizontalAlignment>
                <fontPath>${playtimeFont}</fontPath>
                <fontSize>.022</fontSize>
