<theme>
    <view name="gamelist">
        <carousel name="main">
            <origin>0 0</origin>
            <pos>0 0</pos>	
            <size>1 .9</size>
            <itemSize>.2 0.1</itemSize> 
            <fontPath>${carouselFont}</fontPath>
            <letterCase>${carouselLC}</letterCase>
            <imageType>none</imageType>
            <itemScale>2.6</itemScale>
            <itemsBeforeCenter>0</itemsBeforeCenter>
            <itemsAfterCenter>5</itemsAfterCenter>
