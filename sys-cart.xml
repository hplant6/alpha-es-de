<theme>
<view name="system">
   
        <carousel name="main">
                <origin>.5 0</origin>
                <pos>.5 .11</pos>	
                <size>1 1</size>
                <fontSize>.036</fontSize>
                <itemSize>.26 .26</itemSize> 
                <fontPath>${carouselFont}</fontPath>
                <staticImage>./assets/default-media/physical-media/${system.theme}.webp</staticImage>
                <maxItemCount>3</maxItemCount>
                <imageType>none</imageType>
                <itemScale>2.1</itemScale>
                <lineSpacing>.9</lineSpacing>
                <selectedItemMargins>0 0</selectedItemMargins>
                <selectedItemOffset>0 0</selectedItemOffset>                
                <unfocusedItemOpacity>.5</unfocusedItemOpacity>
                <type>horizontal</type>
                <color>${carItemColor}00</color>
                <fastScrolling>true</fastScrolling>
                <textColor>${carItemColor}</textColor>
                <textSelectedColor>${carouselColor}</textSelectedColor>
                <zIndex>5</zIndex>
        </carousel>
        <text name="sys-title">
            <pos>.5 0.04</pos>
            <origin>.5 0</origin>
            <size>.7 .35</size>
            <lineSpacing>1</lineSpacing>
            <fontPath>${carouselFont}</fontPath>
            <letterCase>${carouselLC}</letterCase>
            <fontSize>.1</fontSize>
            <systemdata>fullname</systemdata>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <color>${carouselColor}</color>
            <zIndex>5</zIndex>
        </text>

        <animation name="animated-UI">
            <visible>${lottieUI}</visible>
            <pos>0 0 </pos>
            <origin>0 0 </origin>
            <size>1 1</size>
            <stationary>withinView</stationary>
            <path>./assets/${assetPath}/animations/16-9/${sysCart}</path>
            <iterationCount>1</iterationCount>
            <zIndex>5</zIndex>
        </animation>
        <image name="image-UI">
            <visible>${imageUI}</visible>
            <pos>0 0 </pos>
            <origin>0 0 </origin>
            <size>1 1</size>
            <path>./assets/${assetPath}/animations/16-9/${sysCartImg}</path>
            <zIndex>5</zIndex>
        </image>
    
        <text name="gstats">
            <pos>.5 .92 </pos>
            <origin>.5 .5 </origin>
            <fontPath>${gstats}</fontPath>
            <fontSize>.05</fontSize>
            <systemdata>gamecount</systemdata> 
            <horizontalAlignment>center</horizontalAlignment>
            <color>${gstatsAltColor}</color>
            <zIndex>5</zIndex>
        </text>
        <animation name="noise">
            <visible>${noise}</visible>
            <pos>0 0 </pos>
            <origin>0 0 </origin>
            <size>1 1</size>
            <stationary>withinView</stationary>
            <path>./assets/${assetPath}/animations/noise.json</path>
            <zIndex>6</zIndex>
        </animation>
         <video name="glistNoise">
            
            <onIterationsDone>${iterationDone}</onIterationsDone>
            <visible>${sysNoise}</visible>
            <audio>false</audio>
            <fadeInType>transparent</fadeInType>
            <pos>0.5 0</pos>
            <cropSize>1 1</cropSize>
            <origin>.5 0</origin>
            <zIndex>10</zIndex>
            <opacity>${sNOpacity}</opacity>
            <path>./assets/${assetPath}/animations/noise.mp4</path>
            <gradientType>vertical</gradientType>
            <iterationCount>${noiseItCount}</iterationCount>
        </video>
        <image name="background">
            <pos>0 0 </pos>
            <origin>0 0 </origin>
            <size>1 1</size>
            <path>${sysbk}</path>
            <color>ffffff</color>
            <colorEnd>${bgGradientEnd}</colorEnd>
            <gradientType>vertical</gradientType>
            <zIndex>0</zIndex>
        </image> 
        <clock name="sysclock">
            <pos>.835 0</pos>
            <scope>view</scope>
            <origin>0 0 </origin>
            <size>.25 .12</size>
            <fontSize>.072</fontSize>
            <horizontalAlignment>left</horizontalAlignment>
            <color>${gmenuAlt2}</color>
            <fontPath>${clock}</fontPath>
        </clock>
        <systemstatus name="status-ind">
            <color>${gmenuAlt2}</color>
            <pos>.16 .024</pos>
            <entries>battery</entries>
            <height>0.025</height>
            <textRelativeScale>1</textRelativeScale>
            <fontPath>${battlvl}</fontPath>
            <customIcon icon="icon_battery_low">${icon_battery_low}</customIcon>
            <customIcon icon="icon_battery_medium">${icon_battery_medium}</customIcon>
            <customIcon icon="icon_battery_high">${icon_battery_high}</customIcon>
            <customIcon icon="icon_battery_full">${icon_battery_full}</customIcon>
            <customIcon icon="icon_battery_icon_battery_charging">${battery_charging}</customIcon>
        </systemstatus>

        <helpsystem name="help">
            <pos>0.5 0.05 </pos>
             <origin>.5 0 </origin>
             <fontSize>.025</fontSize>
            <fontPath>${helpFont}</fontPath>
            <textColor>${gmenuAlt2}</textColor>
            <iconColor>${gmenuAlt2}</iconColor>
            <letterCase>lowercase</letterCase>
            <entries>left/right, x, y, start, back, l, r, lt, rt</entries>
             <customButtonIcon button="dpad_updown">./assets/icons/dpad_updown.svg</customButtonIcon>
            <customButtonIcon button="dpad_leftright">./assets/icons/dpad_leftright.svg</customButtonIcon>
            <customButtonIcon button="dpad_all">./assets/icons/dpad_all.svg</customButtonIcon>
            <customButtonIcon button="thumbstick_click">./assets/icons/thumbstick_click.svg</customButtonIcon>
            <customButtonIcon button="button_l">./assets/icons/button_l.svg</customButtonIcon>
            <customButtonIcon button="button_r">./assets/icons/button_r.svg</customButtonIcon>
            <customButtonIcon button="button_lr">./assets/icons/button_lr.svg</customButtonIcon>
            <customButtonIcon button="button_lt">./assets/icons/button_lt.svg</customButtonIcon>
            <customButtonIcon button="button_rt">./assets/icons/button_rt.svg</customButtonIcon>
            <customButtonIcon button="button_ltrt">./assets/icons/button_ltrt.svg</customButtonIcon>
            <customButtonIcon button="button_a_XBOX">./assets/icons/button_a_XBOX.svg</customButtonIcon>
            <customButtonIcon button="button_b_XBOX">./assets/icons/button_b_XBOX.svg</customButtonIcon>
            <customButtonIcon button="button_x_XBOX">./assets/icons/button_x_XBOX.svg</customButtonIcon>
            <customButtonIcon button="button_y_XBOX">./assets/icons/button_y_XBOX.svg</customButtonIcon>
            <customButtonIcon button="button_back_XBOX">./assets/icons/button_back_XBOX.svg</customButtonIcon>
            <customButtonIcon button="button_start_XBOX">./assets/icons/button_start_XBOX.svg</customButtonIcon>
            <customButtonIcon button="button_back_XBOX360">./assets/icons/button_back_XBOX360.svg</customButtonIcon>
            <customButtonIcon button="button_start_XBOX360">./assets/icons/button_start_XBOX360.svg</customButtonIcon>
            <customButtonIcon button="button_a_PS">./assets/icons/button_a_PS.svg</customButtonIcon>
            <customButtonIcon button="button_b_PS">./assets/icons/button_b_PS.svg</customButtonIcon>
            <customButtonIcon button="button_x_PS">./assets/icons/button_x_PS.svg</customButtonIcon>
            <customButtonIcon button="button_y_PS">./assets/icons/button_y_PS.svg</customButtonIcon>
            <customButtonIcon button="button_back_PS123">./assets/icons/button_back_PS123.svg</customButtonIcon>
            <customButtonIcon button="button_start_PS123">./assets/icons/button_start_PS123.svg</customButtonIcon>
            <customButtonIcon button="button_back_PS4">./assets/icons/button_back_PS4.svg</customButtonIcon>
