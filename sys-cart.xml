            <customButtonIcon button="button_back_PS5">./assets/icons/button_back_PS5.svg</customButtonIcon>
            <customButtonIcon button="button_start_PS5">./assets/icons/button_start_PS5.svg</customButtonIcon>
            <customButtonIcon button="button_a_switch">./assets/icons/button_a_XBOX.svg</customButtonIcon>
            <customButtonIcon button="button_b_switch">./assets/icons/button_b_XBOX.svg</customButtonIcon>
            <customButtonIcon button="button_x_switch">./assets/icons/button_x_XBOX.svg</customButtonIcon>
            <customButtonIcon button="button_y_switch">./assets/icons/button_y_XBOX.svg</customButtonIcon>
            <customButtonIcon button="button_back_switch">./assets/icons/button_back_switch.svg</customButtonIcon>
            <customButtonIcon button="button_start_switch">./assets/icons/button_start_switch.svg</customButtonIcon>
            <customButtonIcon button="button_a_SNES">./assets/icons/button_a_XBOX.svg</customButtonIcon>
            <customButtonIcon button="button_b_SNES">./assets/icons/button_b_XBOX.svg</customButtonIcon>
            <customButtonIcon button="button_x_SNES">./assets/icons/button_x_XBOX.svg</customButtonIcon>
