<theme>
<view name="system">
   
        <carousel name="main">
                <origin>.5 0</origin>
                <pos>.5 .1</pos>	
                <size>1 1</size>
                <fontSize>.036</fontSize>
                <itemSize>.26 .26</itemSize> 
                <fontPath>${carouselFont}</fontPath>
                <staticImage>./assets/default-media/physical-media/${system.theme}.webp</staticImage>
                <maxItemCount>3</maxItemCount>
                <imageType>none</imageType>
                <itemScale>2.1</itemScale>
                <lineSpacing>.9</lineSpacing>
                <selectedItemMargins>0 0</selectedItemMargins>
                <selectedItemOffset>0 0</selectedItemOffset>                
                <unfocusedItemOpacity>.5</unfocusedItemOpacity>
                <verticalOffset>0 1</verticalOffset>
                <type>horizontal</type>
                <color>${carItemColor}00</color>
                <fastScrolling>true</fastScrolling>
                <textColor>${carItemColor}</textColor>
                <textSelectedColor>${carouselColor}</textSelectedColor>
                <zIndex>5</zIndex>
        </carousel>
        <text name="sys-title">
            <pos>.5 0.04</pos>
            <origin>.5 0</origin>
            <size>.7 .35</size>
            <lineSpacing>1</lineSpacing>
            <fontPath>${carouselFont}</fontPath>
            <letterCase>${carouselLC}</letterCase>
            <fontSize>.1</fontSize>
            <systemdata>fullname</systemdata>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <color>${carouselColor}</color>
            <zIndex>5</zIndex>
        </text>

        <animation name="animated-UI">
            <visible>${lottieUI}</visible>
            <pos>0 0 </pos>
            <origin>0 0 </origin>
            <size>1 1</size>
            <stationary>withinView</stationary>
            <path>./assets/${assetPath}/animations/16-9/${sysCart}</path>
            <iterationCount>1</iterationCount>
            <zIndex>5</zIndex>
        </animation>
        <image name="image-UI">
            <visible>${imageUI}</visible>
            <pos>0 0 </pos>
            <origin>0 0 </origin>
            <size>1 1</size>
            <path>./assets/${assetPath}/animations/16-9/${sysCartImg}</path>
            <zIndex>5</zIndex>
        </image>
    
        <text name="gstats">
            <pos>.5 .92 </pos>
            <origin>.5 .5 </origin>
            <fontPath>${gstats}</fontPath>
            <fontSize>.05</fontSize>
            <systemdata>gamecount</systemdata> 
            <horizontalAlignment>center</horizontalAlignment>
            <color>${gstatsAltColor}</color>
            <zIndex>5</zIndex>
        </text>
        <animation name="noise">
            <visible>${noise}</visible>
            <pos>0 0 </pos>
            <origin>0 0 </origin>
            <size>1 1</size>
            <stationary>withinView</stationary>
            <path>./assets/${assetPath}/animations/noise.json</path>
            <zIndex>6</zIndex>
        </animation>
         <video name="glistNoise">
            
            <onIterationsDone>${iterationDone}</onIterationsDone>
            <visible>${sysNoise}</visible>
            <audio>false</audio>
            <fadeInType>transparent</fadeInType>
            <fadeInTime>0</fadeInTime>
            <pos>0.5 0</pos>
            <cropSize>1 1</cropSize>
            <origin>.5 0</origin>
            <zIndex>10</zIndex>
            <opacity>${sNOpacity}</opacity>
            <path>./assets/${assetPath}/animations/noise.mp4</path>
            <gradientType>vertical</gradientType>
            <iterationCount>${noiseItCount}</iterationCount>
        </video>
        <video name="backgroundVid">
            <pos>0 0 </pos>
            <origin>0 0 </origin>
            <size>1 1</size>
            <path>${cartbkvid}</path>
            <visible>${sysbkvid-vis}</visible>
            <zIndex>1</zIndex>
        </video> 
        <image name="background">
            <pos>0 0 </pos>
            <origin>0 0 </origin>
            <size>1 1</size>
            <path>${cartbk}</path>
            <color>ffffff</color>
            <colorEnd>${bgGradientEnd}</colorEnd>
            <gradientType>vertical</gradientType>
            <zIndex>0</zIndex>
        </image> 
        <clock name="sysclock">
            <pos>.835 0</pos>
            <scope>view</scope>
            <origin>0 0 </origin>
            <size>.25 .12</size>
            <fontSize>.072</fontSize>
            <horizontalAlignment>left</horizontalAlignment>
            <color>${gmenuAlt2}</color>
            <fontPath>${clock}</fontPath>
        </clock>
        <systemstatus name="status-ind">
            <color>${gmenuAlt2}</color>
            <pos>.16 .024</pos>
            <entries>battery</entries>
            <height>0.025</height>
            <textRelativeScale>1</textRelativeScale>
            <fontPath>${battlvl}</fontPath>
            <customIcon icon="icon_battery_low">${icon_battery_low}</customIcon>
            <customIcon icon="icon_battery_medium">${icon_battery_medium}</customIcon>
            <customIcon icon="icon_battery_high">${icon_battery_high}</customIcon>
            <customIcon icon="icon_battery_full">${icon_battery_full}</customIcon>
            <customIcon icon="icon_battery_icon_battery_charging">${battery_charging}</customIcon>
        </systemstatus>

        <helpsystem name="help">
            <pos>0.5 0.05 </pos>
             <origin>.5 0 </origin>
             <fontSize>.025</fontSize>
            <fontPath>${helpFont}</fontPath>
            <textColor>${gmenuAlt2}</textColor>
            <iconColor>${gmenuAlt2}</iconColor>
            <letterCase>lowercase</letterCase>
            <entries>left/right, x, y, start, back, l, r, lt, rt</entries>
            <customButtonIcon button="dpad_updown">${dpad_updown}</customButtonIcon>
            <customButtonIcon button="dpad_leftright">${dpad_leftright}</customButtonIcon>
            <customButtonIcon button="dpad_all">${dpad_all}</customButtonIcon>
            <customButtonIcon button="thumbstick_click">${thumbstick_click}</customButtonIcon>
            <customButtonIcon button="button_l">${button_l}</customButtonIcon>
            <customButtonIcon button="button_r">${button_r}</customButtonIcon>
            <customButtonIcon button="button_lr">${button_lr}</customButtonIcon>
            <customButtonIcon button="button_lt">${button_lt}</customButtonIcon>
            <customButtonIcon button="button_rt">${button_rt}</customButtonIcon>
            <customButtonIcon button="button_ltrt">${button_ltrt}</customButtonIcon>
            <customButtonIcon button="button_a_XBOX">${button_a_XBOX}</customButtonIcon>
            <customButtonIcon button="button_b_XBOX">${button_b_XBOX}</customButtonIcon>
            <customButtonIcon button="button_x_XBOX">${button_x_XBOX}</customButtonIcon>
            <customButtonIcon button="button_y_XBOX">${button_y_XBOX}</customButtonIcon>
            <customButtonIcon button="button_back_XBOX">${button_back_XBOX}</customButtonIcon>
            <customButtonIcon button="button_start_XBOX">${button_start_XBOX}</customButtonIcon>
            <customButtonIcon button="button_back_XBOX360">${button_back_XBOX360}</customButtonIcon>
            <customButtonIcon button="button_start_XBOX360">${button_start_XBOX360}</customButtonIcon>
            <customButtonIcon button="button_a_PS">${button_a_PS}</customButtonIcon>
            <customButtonIcon button="button_b_PS">${button_b_PS}</customButtonIcon>
            <customButtonIcon button="button_x_PS">${button_x_PS}</customButtonIcon>
            <customButtonIcon button="button_y_PS">${button_y_PS}</customButtonIcon>
            <customButtonIcon button="button_back_PS123">${button_back_PS123}</customButtonIcon>
            <customButtonIcon button="button_start_PS123">${button_start_PS123}</customButtonIcon>
            <customButtonIcon button="button_back_PS4">${button_back_PS4}</customButtonIcon>
            <customButtonIcon button="button_start_PS4">${button_start_PS4}</customButtonIcon>
            <customButtonIcon button="button_back_PS5">${button_back_PS5}</customButtonIcon>
            <customButtonIcon button="button_start_PS5">${button_start_PS5}</customButtonIcon>
            <customButtonIcon button="button_a_switch">${button_a_XBOX}</customButtonIcon>
            <customButtonIcon button="button_b_switch">${button_b_XBOX}</customButtonIcon>
            <customButtonIcon button="button_x_switch">${button_x_XBOX}</customButtonIcon>
            <customButtonIcon button="button_y_switch">${button_y_XBOX}</customButtonIcon>
            <customButtonIcon button="button_back_switch">${button_back_switch}</customButtonIcon>
            <customButtonIcon button="button_start_switch">${button_start_switch}</customButtonIcon>
            <customButtonIcon button="button_a_SNES">${button_a_XBOX}</customButtonIcon>
            <customButtonIcon button="button_b_SNES">${button_b_XBOX}</customButtonIcon>
            <customButtonIcon button="button_x_SNES">${button_x_XBOX}</customButtonIcon>
            <customButtonIcon button="button_y_SNES">${button_y_XBOX}</customButtonIcon>
            <customButtonIcon button="button_back_SNES">${button_back_XBOX}</customButtonIcon>
            <customButtonIcon button="button_start_SNES">${button_start_XBOX}</customButtonIcon>    
        </helpsystem>
    </view>
