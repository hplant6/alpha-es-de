<theme>
    <view name="system">
        <carousel name="main">
                <origin>.5 0</origin>
                <pos>.5 0</pos>	
                <size>.9 1</size>
                <fontSize>.036</fontSize>
                <itemSize>.3 .3</itemSize> 
                <fontPath>${carouselFont}</fontPath>
                <letterCase>${carouselLC}</letterCase>
                <imageType>none</imageType>
                <itemScale>3</itemScale>
                <lineSpacing>.9</lineSpacing>
                <!-- <staticImage>./assets/theme-mac/type/titles/${system.theme}.svg</staticImage> -->
                <unfocusedItemOpacity>0</unfocusedItemOpacity>
                <type>horizontalWheel</type>
                <itemsBeforeCenter>0</itemsBeforeCenter>
                <itemsAfterCenter>0</itemsAfterCenter>
                <horizontalOffset>0</horizontalOffset>
                <itemRotationOrigin> -3 -.05 </itemRotationOrigin>
                <itemRotation>-25</itemRotation> 
                <wheelHorizontalAlignment>left</wheelHorizontalAlignment>
                <verticalOffset> -.28 </verticalOffset>
                <color>${carouselAltColor}00</color>
                <fastScrolling>true</fastScrolling>
                <textColor>${carItemAltColor}</textColor>
                <textSelectedColor>${carouselAltColor}</textSelectedColor>
                <zIndex>5</zIndex>
        </carousel>
        <video name="gamevid">
            <pos>${gamevidP-16-9}</pos>  
            <cropSize>${gamevidS-16-9}</cropSize>
            <origin>.5 .5 </origin>
            <zIndex>3</zIndex>
            <path>./assets/default-media/videos/${system.theme}.mp4</path>
            <gradientType>vertical</gradientType>
        </video>
        <image name="tvfg">
            <pos>0.5 0</pos>
            <origin>.5 0</origin>
            <cropSize>1 1</cropSize>
            <opacity>1</opacity>
            <path>./assets/${assetPath}/animations/tv-overlay.webp</path>
            <zIndex>4</zIndex>
        </image>
        <video name="tvbg">
            <fadeInType>transparent</fadeInType>
            <fadeInTime>.02</fadeInTime>
            <pos>0.5 0</pos>
            <cropSize>1 1</cropSize>
            <origin>.5 0</origin>
            <zIndex>1</zIndex>
            <path>./assets/${assetPath}/animations/tvbg.mp4</path>
            <gradientType>vertical</gradientType>
        </video>
        <image name="tvbg-img">
            <pos>0.5 0</pos>
            <origin>.5 0</origin>
            <cropSize>1 1</cropSize>
            <path>./assets/${assetPath}/animations/tvbg.webp</path>
            <zIndex>0</zIndex>
        </image>
        <image name="cartridge">
            <pos>${cart-16-9}</pos>
            <color>${cartColor}</color>
            <origin>.5 .5 </origin>
            <maxSize>.12 .12</maxSize>
            <path>./assets/default-media/physical-media/${system.theme}.webp</path>
            <zIndex>3</zIndex>
        </image>

        <animation name="animated-UI">
            <visible>${lottieUI}</visible>
            <pos>0 0 </pos>
            <origin>0 0 </origin>
            <size>1 1</size>
            <stationary>withinView</stationary>
            <path>./assets/${assetPath}/animations/16-9/${sysSsaver}</path>
            <iterationCount>1</iterationCount>
            <zIndex>5</zIndex>
        </animation>
        <image name="image-UI">
            <visible>${imageUI}</visible>
            <pos>0 0 </pos>
            <origin>0 0 </origin>
            <size>1 1</size>
            <path>./assets/${assetPath}/animations/16-9/${sysSsaverImg}</path>
            <zIndex>5</zIndex>
        </image>
        <gameselector name="gameselector1">
            <selection>lastplayed</selection>
            <gameCount>1</gameCount>
            <allowDuplicates>false</allowDuplicates>
        </gameselector>
        
        <animation name="noise">
            <visible>${noise}</visible>
            <pos>0 0 </pos>
            <origin>0 0 </origin>
            <size>1 1</size>
            <stationary>withinView</stationary>
            <path>./assets/${assetPath}/animations/noise.json</path>
            <iterationCount>0</iterationCount>
            <zIndex>6</zIndex>
        </animation>
         <video name="glistNoise">
            
            <onIterationsDone>${iterationDone}</onIterationsDone>
            <visible>${sysNoise}</visible>
            <audio>false</audio>
            <fadeInType>transparent</fadeInType>
            <fadeInTime>0</fadeInTime>
            <pos>0.5 0</pos>
            <cropSize>1 1</cropSize>
            <origin>.5 0</origin>
            <zIndex>10</zIndex>
            <opacity>${sNOpacity}</opacity>
            <path>./assets/${assetPath}/animations/noise.mp4</path>
            <gradientType>vertical</gradientType>
            <iterationCount>${noiseItCount}</iterationCount>
        </video>
        <text name="gstats">
            <pos>.5 .92 </pos>
            <origin>.5 .5 </origin>
            <fontPath>${gstats}</fontPath>
            <fontSize>.05</fontSize>
            <systemdata>gamecount</systemdata>
            <horizontalAlignment>center</horizontalAlignment>
            <color>${gstatsAltColor}</color>
            <zIndex>5</zIndex>
        </text>
        <clock name="sysclock">
            <pos>.835 0</pos>
            <scope>view</scope>
            <origin>0 0 </origin>
            <size>.25 .12</size>
            <fontSize>.072</fontSize>
            <horizontalAlignment>left</horizontalAlignment>
            <color>${gmenuAlt}</color>
            <fontPath>${clock}</fontPath>
        </clock>
        <systemstatus name="status-ind">
            <color>${gmenuAlt}</color>
            <pos>.16 .024</pos>
            <entries>battery</entries>
            <height>0.025</height>
            <textRelativeScale>1</textRelativeScale>
            <fontPath>${battlvl}</fontPath>
            <customIcon icon="icon_battery_low">${icon_battery_low}</customIcon>
            <customIcon icon="icon_battery_medium">${icon_battery_medium}</customIcon>
            <customIcon icon="icon_battery_high">${icon_battery_high}</customIcon>
            <customIcon icon="icon_battery_full">${icon_battery_full}</customIcon>
            <customIcon icon="icon_battery_icon_battery_charging">${battery_charging}</customIcon>
        </systemstatus>

        <helpsystem name="help">
            <pos>0.5 0.05 </pos>
             <origin>.5 0 </origin>
             <fontSize>.025</fontSize>
            <fontPath>${helpFont}</fontPath>
            <textColor>${gmenuAlt}</textColor>
            <iconColor>${gmenuAlt}</iconColor>
            <letterCase>lowercase</letterCase>
            <entries>left/right, x, y, start, back, l, r, lt, rt</entries>
             <customButtonIcon button="dpad_updown">./assets/icons/dpad_updown.svg</customButtonIcon>
            <customButtonIcon button="dpad_leftright">./assets/icons/dpad_leftright.svg</customButtonIcon>
            <customButtonIcon button="dpad_all">./assets/icons/dpad_all.svg</customButtonIcon>
            <customButtonIcon button="thumbstick_click">./assets/icons/thumbstick_click.svg</customButtonIcon>
            <customButtonIcon button="button_l">./assets/icons/button_l.svg</customButtonIcon>
            <customButtonIcon button="button_r">./assets/icons/button_r.svg</customButtonIcon>
            <customButtonIcon button="button_lr">./assets/icons/button_lr.svg</customButtonIcon>
            <customButtonIcon button="button_lt">./assets/icons/button_lt.svg</customButtonIcon>
            <customButtonIcon button="button_rt">./assets/icons/button_rt.svg</customButtonIcon>
            <customButtonIcon button="button_ltrt">./assets/icons/button_ltrt.svg</customButtonIcon>
            <customButtonIcon button="button_a_XBOX">./assets/icons/button_a_XBOX.svg</customButtonIcon>
