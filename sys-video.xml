<theme>
<view name="system">
   
        <carousel name="main">
                <origin>0 0</origin>
                <pos>0 0</pos>	
                <size>1 1</size>
                <fontSize>.036</fontSize>
                <itemSize>.3 .3</itemSize> 
                <fontPath>${carouselFont}</fontPath>
                <letterCase>${carouselLC}</letterCase>
                <imageType>none</imageType>
                <itemScale>3</itemScale>
                <lineSpacing>.9</lineSpacing>
                <!-- <staticImage>./assets/theme-mac/type/titles/${system.theme}.svg</staticImage> -->
                <unfocusedItemOpacity>0</unfocusedItemOpacity>
                <type>horizontalWheel</type>
                <itemsBeforeCenter>0</itemsBeforeCenter>
                <itemsAfterCenter>0</itemsAfterCenter>
                <horizontalOffset>0</horizontalOffset>
                <itemRotationOrigin> -3 -.05 </itemRotationOrigin>
                <itemRotation>-25</itemRotation> 
                <wheelHorizontalAlignment>left</wheelHorizontalAlignment>
                <verticalOffset> -.28 </verticalOffset>
                <color>${carItemColor}00</color>
                <fastScrolling>true</fastScrolling>
                <textColor>${carItemColor}</textColor>
                <textSelectedColor>${carouselColor}</textSelectedColor>
                <zIndex>5</zIndex>
        </carousel>
        <animation name="animated-UI">
            <visible>${lottieUI}</visible>
            <pos>0 0 </pos>
            <origin>0 0 </origin>
            <size>1 1</size>
            <stationary>withinView</stationary>
            <path>./assets/${assetPath}/animations/16-9/${sysVideo}</path>
            <iterationCount>1</iterationCount>
            <zIndex>4</zIndex>
        </animation>
        <image name="image-UI">
            <visible>${imageUI}</visible>
            <pos>0 0 </pos>
            <origin>0 0 </origin>
            <size>1 1</size>
            <path>./assets/${assetPath}/animations/16-9/${sysVideoImg}</path>
            <zIndex>4</zIndex>
        </image>
        <image name="polaroidBG">
            <visible>${frame}</visible>
            <pos>0 0 </pos>
            <origin>0 0 </origin>
            <size>1 1</size>
            <path>./assets/${assetPath}/frames/system/16-9/PolaroidBG.webp</path>
            <zIndex>2</zIndex>
        </image>
        <video name="gamevid-r">
            <pos>0.73 0.36 </pos>
            <cropSize>.21 .37 </cropSize>
            <cropPos>.5 0 </cropPos> 
            <origin>.5 0 </origin>
            <zIndex>3</zIndex>
            <rotation>-${roidRotate}</rotation>
            <colorEnd>${roidGradientEnd}</colorEnd>
            <gradientType>vertical</gradientType>
            <default>./assets/default-media/videos/${system.theme}.mp4</default>
            <gameselector>gameselector2</gameselector>
        </video>
        <video name="gamevid-l">
            <pos>0.27 0.36 </pos>
            <audio>false</audio>
            <cropSize>.21 .37 </cropSize>
            <cropPos>.5 0 </cropPos> 
            <origin>.5 0 </origin>
            <zIndex>3</zIndex>
            <rotation>${roidRotate}</rotation>
            <colorEnd>${roidGradientEnd}</colorEnd>
            <gradientType>vertical</gradientType>
            <default>./assets/default-media/videos/${system.theme}.mp4</default>
            <gameselector>gameselector1</gameselector>
        </video>
        <text name="gtitle-r">
            <pos>0.735 0.74</pos>
            <origin>.5 0 </origin>
            <size>.15 .09</size>
            <fontPath>${recentTit}</fontPath>
            <fontSize>.04</fontSize>
            <metadata>name</metadata>
            <lineSpacing>1</lineSpacing>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <color>${recentTitColor}</color>
            <zIndex>5</zIndex>
            <rotation>-${recentRotate}</rotation>
            <gameselector>gameselector2</gameselector>
        </text>
        <text name="gtitle-l">
            <pos>0.25 0.74</pos>
            <origin>.5 0 </origin>
            <size>.15 .09</size>
            <fontPath>${recentTit}</fontPath>
            <fontSize>.04</fontSize>
            <metadata>name</metadata>
            <lineSpacing>1</lineSpacing>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <color>${recentTitColor}</color>
            <zIndex>5</zIndex>
            <rotation>${recentRotate}</rotation>
            <gameselector>gameselector1</gameselector>
        </text>
        <image name="polaroidFG">
            <visible>${frame}</visible>
            <pos>0 0 </pos>
            <origin>0 0 </origin>
            <size>1 1</size>
            <path>./assets/${assetPath}/frames/system/16-9/PolaroidFG.webp</path>
            <zIndex>4</zIndex> 
        </image>
        <gameselector name="gameselector1">
            <selection>lastplayed</selection>
            <gameCount>5</gameCount>
            <allowDuplicates>false</allowDuplicates>
        </gameselector>
        <gameselector name="gameselector2">
            <selection>mostplayed</selection>
            <gameCount>5</gameCount>
            <allowDuplicates>false</allowDuplicates>
