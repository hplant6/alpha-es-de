            <pos>0.5 0.61 </pos>
            <origin>.5 .5 </origin>
            <maxSize>.53 .53</maxSize>
            <path>./assets/default-media/physical-media/${system.theme}.webp</path>
            <zIndex>7</zIndex>
        </image>
        <image name="cartridgeshadow">
            <visible>${cshadow}</visible>
            <pos>0.503 0.62 </pos>
            <origin>.5 .5 </origin>
            <maxSize>.53 .53</maxSize>
            <color>000000</color>
            <brightness>0</brightness>
            <opacity>.25</opacity>
