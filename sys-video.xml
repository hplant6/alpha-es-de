            <zIndex>6</zIndex>
        </image>
        <text name="gstats">
            <pos>.5 .92 </pos>
            <origin>.5 .5 </origin>
            <fontPath>${gstats}</fontPath>
            <fontSize>.05</fontSize>
            <systemdata>gamecount</systemdata>
            <horizontalAlignment>center</horizontalAlignment>
            <color>${gstatsColor}</color>
            <zIndex>5</zIndex>
        </text>
        <animation name="noise">
            <visible>${noise}</visible>
            <pos>0 0 </pos>
            <origin>0 0 </origin>
            <size>1 1</size>
            <stationary>withinView</stationary>
            <path>./assets/${assetPath}/animations/noise.json</path>
            <iterationCount>0</iterationCount>
            <zIndex>6</zIndex>
        </animation>
        <video name="glistNoise">
            
            <onIterationsDone>${iterationDone}</onIterationsDone>
            <visible>${sysNoise}</visible>
            <audio>false</audio>
            <fadeInType>transparent</fadeInType>
            <pos>0.5 0</pos>
            <cropSize>1 1</cropSize>
            <origin>.5 0</origin>
            <zIndex>10</zIndex>
            <opacity>${sNOpacity}</opacity>
            <path>./assets/${assetPath}/animations/noise.mp4</path>
            <gradientType>vertical</gradientType>
            <iterationCount>${noiseItCount}</iterationCount>
        </video>
